{
  "mcpServers": {
    "browser-vision": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },

    "project-context": {
      "command": "npx",
      "args": [
        "-y",
        "context-mode"
      ],
      "env": {
        "NODE_ENV": "production"
      }
    }
  }
}
