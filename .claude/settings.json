{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-shell-writes.mjs\"",
            "timeout": 10,
            "statusMessage": "シェル書込みの検査"
          }
        ]
      }
    ]
  }
}
